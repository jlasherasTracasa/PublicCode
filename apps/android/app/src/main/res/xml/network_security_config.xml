<?xml version="1.0" encoding="utf-8"?>
<!-- pcoded aún no sirve TLS: se permite HTTP en claro para la red local o un túnel (WireGuard,
     Tailscale). Con TLS delante (proxy inverso), usa una URL https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
